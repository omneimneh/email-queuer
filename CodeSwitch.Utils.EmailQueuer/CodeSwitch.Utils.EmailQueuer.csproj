<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Omar Mneimneh</Authors>
    <PackageId>CodeSwitch.Utils.EmailQueuer</PackageId>
    <PackageTags>Email, Smtp, Queue, Razor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>2.3.0-rc.1: Priority and per-partition fairness (new Priority and PartitionKey columns, new EnqueueAsync overload taking EmailEnqueueOptions); the failure reason is recorded on the row (new LastError and LastErrorOn columns); retry waits can be capped (MaxRetryBackoffSeconds) and can no longer overflow into an immediate-retry loop; optional outage pause (OutagePauseThreshold) so a mail server outage does not burn every queued email's retry budget; periodic wake (PollIntervalSeconds, default 120) so rows made due outside the process are picked up; the worker can no longer wedge after an exception or run two loops at once; a hung send is cancelled; stale claims count as a failed attempt; StaleClaimMinutes is bindable from configuration. SCHEMA CHANGE: the host must add four columns to the queue table, see the README section "Upgrading to 2.3.0".
2.2.1: Fix stale-claim reclaim missing legacy rows — rows moved to Sending by pre-2.2.0 code have no NextAttemptOn deadline stamped and were orphaned forever; the reclaim now also recovers NULL-deadline Sending rows older than StaleClaimMinutes (by CreatedOn) back to Error for normal retry. No schema change.
2.2.0: Atomic CAS claim of queued emails (ExecuteUpdateAsync Pending/Error -&gt; Sending only if the row is still in the read status) so multiple worker instances can no longer double-send; stale-claim reclaim of rows left in Sending past a stamped deadline (reuses the existing NextAttemptOn column, no schema change); new RunHostedService option to gate the background worker on parked/standby instances while keeping EnqueueAsync available; configurable StaleClaimMinutes (default 10).</PackageReleaseNotes>
    <Description>A library for asp.net core that allows you to send emails without having memory leaks</Description>
    <RepositoryUrl>https://github.com/omneimneh/email-queuer</RepositoryUrl>
    <RepositoryType></RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
  <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/omneimneh/email-queuer</PackageProjectUrl>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  <Version>2.3.0-rc.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentEmail.Core" Version="3.0.2" />
    <PackageReference Include="FluentEmail.Smtp" Version="3.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <!-- Relational provides the bulk-update extensions (ExecuteUpdateAsync) used by the 2.2.0
         atomic CAS claim + stale-claim reclaim. The library is consumed against SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PreMailer.Net" Version="2.2.0" />
    <PackageReference Include="Razor.Templating.Core" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
 
</Project>
